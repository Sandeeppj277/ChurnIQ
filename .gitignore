# ──────────────────────────────────────────────
# ChurnIQ — Git Ignore
# ──────────────────────────────────────────────

# Environment & Secrets
.env

# Python
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
dist/
build/
*.egg

# Virtual Environment
.venv/
venv/
env/

# ML Artifacts (regenerated by setup_project.py)
ml/artifacts/

# Database files
*.db

# IDE / Editor
.vscode/
.idea/
*.swp
*.swo
*~

# OS files
.DS_Store
Thumbs.db
desktop.ini

# Jupyter (if any)
.ipynb_checkpoints/

# Test / Coverage
.pytest_cache/
htmlcov/
.coverage
