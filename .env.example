# ──────────────────────────────────────────────
# ChurnIQ — Environment Variables
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.
# ──────────────────────────────────────────────

# ── Gemini AI ────────────────────────────────
GEMINI_API_KEY=
AI_MODEL=gemini-3.8-flash

# ── Risk Thresholds (percent) ────────────────
LOW_RISK_MAX=39
MEDIUM_RISK_MAX=69

# ── Database ─────────────────────────────────
# Default: SQLite (churn_dev.db in project root)
# For PostgreSQL, uncomment and set:
# DATABASE_URL=postgresql://user:password@localhost:5432/churniq

# ── Frontend CORS ────────────────────────────
FRONTEND_URL=http://127.0.0.1:5500
